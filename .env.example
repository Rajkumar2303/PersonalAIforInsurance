# ------------------------------------------------------------------
# Ontario All-Quote Agent — environment template
# Copy to `.env` and fill in values. NEVER commit the real `.env`.
# All values here are placeholders.
# ------------------------------------------------------------------

# --- Application ---------------------------------------------------
# development | test | production
APP_ENV=development
APP_NAME=Ontario All-Quote Agent
API_HOST=0.0.0.0
API_PORT=8000

# Frontend origin allowed by CORS (comma-separated list supported)
FRONTEND_ORIGINS=http://localhost:5173

# --- LangSmith (observability) ------------------------------------
# Set to true to enable tracing. Requires LANGSMITH_API_KEY.
# This account uses the EU instance; uncomment the EU endpoint when using it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=ontario-allquote-agent
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Database / evidence store (Issue #10) -------------------------
# PostgreSQL async URL for the durable evidence/audit/trace store. When set AND
# EVIDENCE_REPOSITORY_BACKEND=postgres, evidence persists to Postgres; the
# default in_memory backend keeps everything ephemeral (hermetic tests use
# SQLite directly, not this setting).
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/allquote
# EVIDENCE_REPOSITORY_BACKEND=in_memory
# Optional Postgres integration test URL (Issue #10 Prompt 2). When unset, the
# Postgres-specific tests SKIP cleanly (hermetic suite never needs Docker/cloud).
# POSTGRES_EVIDENCE_TEST_URL=postgresql+asyncpg://user:password@localhost:5432/allquote_test

# --- LLM (placeholder — NOT used in Issue 1) -----------------------
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_API_KEY=

# --- Intake profile vault (Issue #5) ------------------------------
# When set, profile vault data is encrypted at rest (Fernet). The key must
# come ONLY from the environment - never commit it. When unset, an in-memory
# (ephemeral) vault is used instead.
# INTAKE_VAULT_KEY=generate-one-with-fernet-and-put-it-here
# Optional override for the encrypted vault data directory.
# INTAKE_VAULT_DIR=backend/data/vault

# --- Browser agent (Issue #7) -------------------------------------
# Optional override for the data-driven browser route-config dir; defaults to
# backend/data/browser/routes (see app/browser/config.py).
# BROWSER_ROUTE_CONFIG_DIR=
# Headless Chromium is the hermetic-test default; set false (headful) for
# manual/demo observation. Requires `playwright install chromium`.
# BROWSER_HEADLESS=true
# DEV/DEMO ONLY: Playwright slow_mo delay (ms) between browser actions so a
# headful demo is easy to watch. 0 = no delay in tests/production.
# BROWSER_SLOW_MO_MS=0
# When true, LIVE browser execution requires the explicit personal-use gate.
# BROWSER_LIVE_GATE_REQUIRED=true
# Screenshots are optional and must be redacted before persistence.
# BROWSER_SCREENSHOT_ENABLED=false
# Safety bound on the number of browser steps per run.
# BROWSER_MAX_STEPS=20
# Abandoned in-memory browser sessions are closed after this many seconds.
# BROWSER_IDLE_TIMEOUT_SECONDS=600

# --- Recovery (Issue #8) ------------------------------------------
# Optional override for the data-driven recovery-policy dir; defaults to
# backend/data/recovery (see app/services/recovery/policy.py).
# RECOVERY_POLICY_DIR=

# --- Demo / mock overlay (Issue #8.5) ------------------------------
# Optional override for the isolated demo data overlay dir; defaults to
# backend/data/demo (see app/demo/runtime.py). Used ONLY for
# execution_mode=mock - never live. Keeps synthetic routes out of the real
# market registry so real market counts / dedup / reporting are unaffected.
# DEMO_DATA_DIR=
# Local mock quote site (localhost only). Enabled explicitly for dev/demo;
# never a live destination; shut down with the app lifespan.
# MOCK_SITE_ENABLED=true
# MOCK_SITE_HOST=127.0.0.1
# MOCK_SITE_PORT=8765
