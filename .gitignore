# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.coverage.*
*.cover
.hypothesis/

# Environment files — never commit real secrets
.env
.env.local
.env.*.local

# Intake profile vault (Issue #5) — encrypted profile data, never committed
backend/data/vault/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Secrets / credentials (defense in depth — do not commit any key material)
*.pem
*.key
*.p12

# Scratch test artifacts (local junit reports / temp DBs — never committed)
backend/*_junit.xml
backend/*_check.db

# Generated demo report (Issue #14) — synthetic but avoid noise in the repo
reports/

# Local agent memory (workspace-scoped notes — never committed)
memories/

# --- Step 10: privacy hardening (never commit applicant-adjacent data) ---
# Browser profiles, session data, and raw capture artifacts
backend/data/browser/profiles/
backend/data/browser/sessions/
backend/data/browser/artifacts/
backend/data/browser/.state/
backend/data/screenshots/
backend/data/traces/
backend/data/videos/
backend/data/hars/
backend/data/call-recordings/

# Temporary / local evidence and local databases with applicant data
backend/data/tmp-evidence/
backend/data/evidence-local/
backend/data/scratch/
backend/data/local-events.db
*.sqlite3
*.db-wal
*.db-shm

# Playwright raw output (kept out of the repo even when not in test-results/)
backend/**/playwright-artifacts/
backend/**/.playwright/

