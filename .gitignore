test-results/
playwright-report/
blob-report/
playwright/.cache/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Secrets / credentials (defense in depth — do not commit any key material)
*.pem
*.key
*.p12
